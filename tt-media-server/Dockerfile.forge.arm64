# aarch64 variant of Dockerfile.forge. See docs/arm64-forge-image-plan.md.
#
# Tenstorrent only publishes x86_64 builds of tt-forge / pjrt-plugin-tt / torch-xla / tt-lang.
# Put locally built aarch64 wheels in tt-media-server/wheels/ and build with
# --build-arg FORGE_WHEELS=wheels. With the default FORGE_WHEELS=none the image is built
# without the TT device stack (useful for fixing every other arm64 issue, and for CPU paths).
#
# Build from the repo root:
#   docker build --platform linux/arm64 -f tt-media-server/Dockerfile.forge.arm64 \
#     -t tt-media-server-forge:arm64 .
ARG BASE_IMAGE=tt-metalium-release:local
FROM ${BASE_IMAGE}

# Build stage
LABEL maintainer="Igor Djuric <idjuric@tenstorrent.com>"
# connect Github repo with package
LABEL org.opencontainers.image.source=https://github.com/tenstorrent/tt-inference-server

ARG DEBIAN_FRONTEND=noninteractive

# CONTAINER_APP_UID is a random ID, change this and rebuild if it collides with host
ARG CONTAINER_APP_UID=1000
ARG DEBIAN_FRONTEND=noninteractive

ENV ENVIRONMENT=development

ENV SHELL=/bin/bash
ENV CONTAINER_APP_USERNAME=container_app_user
ARG HOME_DIR=/home/${CONTAINER_APP_USERNAME}
# tt-metal build vars
ENV CONFIG=Release
ENV LOGURU_LEVEL=INFO
ENV TT_METAL_LOGS_PATH=/home/container_app_user/logs

# The tt-metalium-release base activates its own Python 3.10 ttnn venv (/opt/venv) via PATH and
# VIRTUAL_ENV. The forge image doesn't use it (TT_METAL_HOME points at pjrt_plugin_tt's bundled
# tt-metal), and leaving it active would send pip3 into a root-owned venv, so drop it.
ENV PATH=/opt/openmpi-v5.0.7-ulfm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV VIRTUAL_ENV=
ENV PYTHON_ENV_DIR=

# extra system deps
RUN apt-get update && apt-get install -y \
    # required
    gosu \
    libgl1 \
    libsndfile1 \
    wget \
    git-lfs \
    nano \
    acl \
    jq \
    vim \
    python3-pip \
    software-properties-common \
    # pyluwen build dependencies (Rust package with protobuf)
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    pkg-config \
    htop \
    screen \
    tmux \
    unzip \
    zip \
    curl \
    libcurl4-openssl-dev \
    iputils-ping \
    rsync \
    && rm -rf /var/lib/apt/lists/* \
    && protoc --version

# Install Python 3.12 which is required for forge
RUN add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update -qq && \
    apt-get install -y -qq python3.12 python3.12-dev python3.12-venv

RUN curl -fsSL https://github.com/Kitware/CMake/releases/download/v3.26.4/cmake-3.26.4-linux-$(uname -m).sh -o cmake.sh && \
    chmod +x cmake.sh && \
    ./cmake.sh --skip-license --prefix=/usr/local && \
    rm cmake.sh && \
    cmake --version

RUN pip3 install --upgrade setuptools wheel \
    && pip3 install cmake \
    && pip3 install cmake --upgrade \
    && hash -r

# user setup
RUN useradd -u ${CONTAINER_APP_UID} -s /bin/bash -d ${HOME_DIR} ${CONTAINER_APP_USERNAME} \
    && mkdir -p ${HOME_DIR} ${HOME_DIR}/logs \
    && chown -R ${CONTAINER_APP_USERNAME}:${CONTAINER_APP_USERNAME} ${HOME_DIR} \
    && mkdir -p /run/sshd \
    && chmod 755 /run/sshd

USER ${CONTAINER_APP_USERNAME}

# install tt-smi
RUN /bin/bash -c "export CARGO_HOME=${HOME_DIR}/.cargo \
    && export RUSTUP_HOME=${HOME_DIR}/.rustup \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --no-modify-path \
    && . ${HOME_DIR}/.cargo/env \
    && rustup update \
    && pip3 install --upgrade pip \
    && pip3 install git+https://github.com/tenstorrent/tt-smi"
ENV PATH=${HOME_DIR}/.local/bin:${PATH}

WORKDIR ${HOME_DIR}

# install inference server requirements
ARG APP_DIR="${HOME_DIR}/app"
ENV APP_DIR=${APP_DIR}
WORKDIR ${APP_DIR}
COPY --chown=${CONTAINER_APP_USERNAME}:${CONTAINER_APP_USERNAME} "tt-media-server" "${APP_DIR}/server"
# Remove private submodule source — cpp_server is not used in the forge image
RUN rm -rf ${APP_DIR}/server/cpp_server

# Directory (relative to tt-media-server/) with aarch64 wheels for pjrt-plugin-tt, torch-xla,
# tt-lang, vllm-tt, ... or "none" to build without the TT device stack.
ARG FORGE_WHEELS=none
USER root
RUN /bin/bash -c "cd ${APP_DIR}/server \
    && if [ '${FORGE_WHEELS}' != 'none' ]; then export FORGE_WHEELS_DIR=${APP_DIR}/server/${FORGE_WHEELS}; fi \
    && source tt_model_runners/forge_runners/setup_env.sh" \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R ${CONTAINER_APP_USERNAME}:${CONTAINER_APP_USERNAME} ${HOME_DIR}
USER ${CONTAINER_APP_USERNAME}
ENV TT_METAL_HOME="${APP_DIR}/server/venv-worker/lib/python3.12/site-packages/pjrt_plugin_tt/tt-metal"
ENV PYTHON_ENV_DIR="${APP_DIR}/server/venv-worker"

# Dedicated CPU venv for merging LoRA adapters under the *inference* transformers version
ENV ADAPTER_MERGE_VENV_DIR="${APP_DIR}/server/merge-venv"
ENV ADAPTER_MERGE_PYTHON="${ADAPTER_MERGE_VENV_DIR}/bin/python"
COPY "tt-vllm-plugin/pyproject.toml" "/tmp/tt-vllm-plugin-pyproject.toml"
RUN python3.12 "${APP_DIR}/server/scripts/build_merge_venv.py" \
    "${ADAPTER_MERGE_VENV_DIR}" "/tmp/tt-vllm-plugin-pyproject.toml"

# spinup inference server
WORKDIR "${APP_DIR}"
EXPOSE 8000
CMD ["/bin/bash", "-c", "cd ${APP_DIR}/server/ && source venv-worker/bin/activate && source ./run_uvicorn.sh --skip-venv"]
